DB_NAME=sistema_vendas
DB_USERNAME=sistema_vendas
DB_PASSWORD=troque-esta-senha
JWT_SEGREDO=troque-este-segredo-com-no-minimo-32-caracteres
JWT_EXPIRACAO_MINUTOS=60
MINIO_ROOT_USER=sistema_vendas
MINIO_ROOT_PASSWORD=troque-esta-senha

# Email de acesso irrestrito (dono/programador). Criado na primeira subida se ainda não existir;
# depois disso, os demais funcionários são cadastrados em "Funcionários e Cargos".
ACESSO_INICIAL_NOME=Dono
ACESSO_INICIAL_EMAIL=
ACESSO_INICIAL_SENHA=

# Credenciais de teste (sandbox) da sua conta Mercado Pago — nunca a de produção em dev
MERCADOPAGO_ACCESS_TOKEN=troque-pelo-token-de-teste-do-mercado-pago
MERCADOPAGO_WEBHOOK_SEGREDO=troque-pelo-segredo-do-webhook-configurado-no-painel

# W-API (WhatsApp não oficial, decisão D2) — ID e TOKEN da instância, no painel.w-api.app.
# WAPI_WEBHOOK_TOKEN: segredo que você inventa; a URL cadastrada no painel da W-API fica
# https://SEU-DOMINIO/api/webhooks/wapi?token=ESTE_VALOR
WAPI_INSTANCE_ID=
WAPI_TOKEN=
WAPI_WEBHOOK_TOKEN=troque-por-um-segredo-longo-e-aleatorio

# Número INTERNO do assistente (outra instância da W-API, outro chip). Só funcionários verificados.
# URL no painel da W-API: https://SEU-DOMINIO/api/webhooks/wapi-assistente?token=ESTE_VALOR
WAPI_ASSISTENTE_INSTANCE_ID=
WAPI_ASSISTENTE_TOKEN=
WAPI_ASSISTENTE_WEBHOOK_TOKEN=troque-por-outro-segredo-longo-e-aleatorio

# Assistente do gestor (RF02/D6) — IA somente leitura, respondendo via WhatsApp só ao dono
DONO_WHATSAPP_TELEFONE=5585999999999
CLAUDE_API_KEY=
CLAUDE_MODELO=claude-haiku-4-5-20251001

# Bot de atendimento ao cliente — chave SEPARADA da do gestor. Vazia = bot transfere tudo para humano.
CLAUDE_API_KEY_ATENDIMENTO=

# Emissão fiscal — vazios = emissão desabilitada (a aba Fiscal mostra o que falta)
FISCAL_AMBIENTE=HOMOLOGACAO
FISCAL_CERTIFICADO_A1_CAMINHO=
FISCAL_REGIME_TRIBUTARIO=
FOCUS_NFE_TOKEN=
